# ============================================
# Synkra AIOS Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research Tools
# --------------------------------------------

# Exa Search API (web search for agents)
# Get your key at: https://exa.ai/
EXA_API_KEY=

# Context7 (library documentation lookup)
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=

# --------------------------------------------
# Database & Backend
# --------------------------------------------

# Supabase (database, auth, storage)
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL do app em produção (links de convite/redefinição de senha)
# Deve ser o MESMO domínio configurado em Supabase Auth → URL Configuration → Site URL
# Ex.: https://app.precificacerto.com
NEXT_PUBLIC_APP_URL=

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --------------------------------------------
# Project Management
# --------------------------------------------

# ClickUp API (if using ClickUp integration)
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=

# --------------------------------------------
# Automation & Workflows
# --------------------------------------------

# N8N (workflow automation)
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring & Analytics
# --------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=

# --------------------------------------------
# Cloud Providers
# --------------------------------------------

# Railway (deployment)
RAILWAY_TOKEN=

# Vercel (deployment)
VERCEL_TOKEN=

# --------------------------------------------
# AIOS Core Configuration
# --------------------------------------------
NODE_ENV=development
AIOS_VERSION=2.2.0

# --------------------------------------------
# Stripe (Payment Processing)
# --------------------------------------------

# Stripe API Keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=7

# Stripe Product IDs
# Produto: Precifica Certo - Assinatura (Até 200k)
STRIPE_PRODUCT_ATE_200K=prod_U8UXLz2diYy91F
# Produto: Precifica Certo - Assinatura (Acima de 200k)
STRIPE_PRODUCT_ACIMA_200K=prod_U8UXhVwZwkXWI3

# Stripe Price IDs - Faixa até R$ 200k/mês (4 planos)
# Individual R$ 99,90 | Intermediário R$ 239,90 | Pro R$ 299,90 | Advanced R$ 349,90
STRIPE_PRICE_ATE_200K_INDIVIDUAL=
STRIPE_PRICE_ATE_200K_INTERMEDIARIO=
STRIPE_PRICE_ATE_200K_PRO=
STRIPE_PRICE_ATE_200K_ADVANCED=

# Stripe Price IDs - Faixa acima de R$ 200k/mês (4 planos)
# Individual R$ 299,90 | Intermediário R$ 399,90 | Pro R$ 499,90 | Advanced R$ 549,90
STRIPE_PRICE_ACIMA_200K_INDIVIDUAL=
STRIPE_PRICE_ACIMA_200K_INTERMEDIARIO=
STRIPE_PRICE_ACIMA_200K_PRO=
STRIPE_PRICE_ACIMA_200K_ADVANCED=

# --------------------------------------------
# Google Sheets (funil de leads — aviso de pagamento)
# --------------------------------------------
# Web App (Apps Script) da planilha do funil + token que ele valida.
# Hoje existem só no projeto Vercel do FUNIL; precisam ser cadastradas também no
# projeto do SISTEMA (mesmos valores) para o webhook do Stripe marcar "pagou" na
# planilha. Só o Cristiano tem acesso ao painel. Se faltarem, o aviso é pulado —
# não quebra o webhook (apenas um aviso no log).
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# --------------------------------------------
# Cron Jobs (Vercel Scheduled Functions)
# --------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use o MESMO valor no Vercel Dashboard → Settings → Environment Variables
# Vercel Cron envia automaticamente como header: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=

# --------------------------------------------
# Custom Configuration
# --------------------------------------------
# Add your custom API keys below
